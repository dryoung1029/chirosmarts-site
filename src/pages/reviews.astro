---
/**
 * Public reviews page — owns the "ChiroSmarts reviews" brand query.
 *
 * Content is the same owner-curated `testimonials` collection used on the
 * homepage and course pages: real, attributed, never fabricated. Deliberately
 * NO Review/AggregateRating JSON-LD — Google's self-serving-review policy
 * excludes reviews a business collects about itself, so markup here would earn
 * no stars and only risk a structured-data penalty. The off-site link (when
 * TRUSTPILOT_REVIEW_URL is set) is where independent, indexable reviews live.
 */
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { getCollection } from "astro:content";
import { getDb } from "@/db/client";
import { getCourseBySlug } from "@/lib/courses";

const env = Astro.locals.runtime.env;
const trustpilotUrl = env.TRUSTPILOT_REVIEW_URL || "";

const all = await getCollection("testimonials");

// Group by course so a visitor can see reviews for the training they're
// considering; untagged testimonials fall into a general bucket.
const db = getDb(env);
const slugs = [...new Set(all.map((t) => t.data.courseTag).filter(Boolean))] as string[];
const courseTitles = new Map<string, string>();
for (const slug of slugs) {
  const c = await getCourseBySlug(db, slug);
  if (c) courseTitles.set(slug, c.title);
}

const groups: { heading: string; items: typeof all }[] = [];
for (const slug of slugs) {
  const items = all.filter((t) => t.data.courseTag === slug);
  if (items.length) groups.push({ heading: courseTitles.get(slug) ?? slug, items });
}
const untagged = all.filter((t) => !t.data.courseTag);
if (untagged.length) groups.push({ heading: "About ChiroSmarts", items: untagged });
---

<MarketingLayout
  title="ChiroSmarts reviews — what Oregon CAs and clinics say"
  description="Real reviews of ChiroSmarts Oregon Chiropractic Assistant training, from the doctors and CAs who've used it to get certified."
  canonicalPath="/reviews"
>
  <section class="mk-section" style="padding-top:3rem">
    <div class="mk-container" style="max-width:820px">
      <h1 style="margin-bottom:0.5rem">ChiroSmarts reviews</h1>
      <p style="color:var(--muted);font-size:1.05rem;max-width:60ch">
        Feedback from the Oregon chiropractors and chiropractic assistants who've
        used ChiroSmarts to get certified. Every review below is from a real
        student or supervising doctor, published with their permission.
      </p>

      {all.length === 0 ? (
        <div class="mk-card" style="margin-top:1.5rem">
          <p style="margin:0;color:var(--muted)">
            We're collecting reviews from recent graduates now — check back soon.
          </p>
        </div>
      ) : (
        groups.map((g) => (
          <div style="margin-top:2.25rem">
            <h2 style="font-size:1.15rem;margin-bottom:1rem">{g.heading}</h2>
            <div class="mk-grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
              {g.items.map((t) => (
                <figure class="mk-card" style="margin:0">
                  <blockquote style="margin:0 0 0.75rem;font-size:1.02rem">“{t.data.quote}”</blockquote>
                  <figcaption style="display:flex;align-items:center;gap:0.6rem;color:var(--muted);font-size:0.9rem">
                    {t.data.photo && (
                      <img src={t.data.photo} alt="" width="36" height="36" loading="lazy" style="border-radius:50%" />
                    )}
                    <span>
                      <strong style="color:var(--text)">{t.data.name}</strong>
                      {(t.data.role || t.data.clinic) && (
                        <span> — {[t.data.role, t.data.clinic].filter(Boolean).join(", ")}</span>
                      )}
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      )}

      <div class="mk-card" style="margin-top:2.5rem">
        <h2 style="font-size:1.1rem;margin:0 0 0.5rem">Finished a course?</h2>
        <p style="margin:0 0 1rem;color:var(--muted)">
          {trustpilotUrl
            ? "We email every graduate a review link — and you can also leave an independent review on Trustpilot."
            : "We email every graduate a link to share how it went. Your words help other Oregon CAs decide."}
        </p>
        {trustpilotUrl && (
          <a class="btn-primary" href={trustpilotUrl} target="_blank" rel="noopener noreferrer">
            Review us on Trustpilot →
          </a>
        )}
      </div>

      <p style="margin-top:2rem">
        <a href="/courses">Browse the course catalog →</a>
      </p>
    </div>
  </section>
</MarketingLayout>
