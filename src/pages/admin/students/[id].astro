---
import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/AdminNav.astro";
import { getDb, schema } from "@/db/client";
import { desc, eq } from "drizzle-orm";
import { getCourseSeatTime } from "@/lib/progress";
import { getCourseStructure } from "@/lib/courses";
import { unpassedQuizzes } from "@/lib/quiz";
import { listCertificates } from "@/lib/certificate";
import { formatPacific } from "@/lib/time";
import { isAdminEmail } from "@/lib/admin";
import { getMailingStatus, STATUS_HELP, STATUS_LABEL } from "@/lib/audience";
import { lastPrefEvent } from "@/lib/email-prefs";
import { ago, ATTENTION, buildRoster, FLAG_HELP, FLAG_LABEL } from "@/lib/admin/roster";

const db = getDb(Astro.locals.runtime.env);
const userId = Astro.params.id!;

const student = await db
  .select()
  .from(schema.users)
  .where(eq(schema.users.id, userId))
  .get();
if (!student) return Astro.redirect("/admin/students", 302);

// Enrollments + course, with seat-time audit and certificates per course.
const enrollRows = await db
  .select({ e: schema.enrollments, c: schema.courses })
  .from(schema.enrollments)
  .innerJoin(schema.courses, eq(schema.enrollments.courseId, schema.courses.id))
  .where(eq(schema.enrollments.userId, userId))
  .all();

const courseAudits = await Promise.all(
  enrollRows.map(async ({ e, c }) => ({
    enrollment: e,
    course: c,
    seat: await getCourseSeatTime(db, userId, c.id),
    certs: await listCertificates(db, userId, c.id),
    unpassed: await unpassedQuizzes(db, userId, c.id),
    modules: await getCourseStructure(db, c.id),
  })),
);

// Quiz attempts (append-only record), newest first, with quiz labels.
const attempts = await db
  .select()
  .from(schema.quizAttempts)
  .where(eq(schema.quizAttempts.userId, userId))
  .orderBy(desc(schema.quizAttempts.submittedAt))
  .all();
const quizRows = await db.select().from(schema.quizzes).all();
const quizMap = new Map(quizRows.map((q) => [q.id, q]));

// Recent raw audit events.
const events = await db
  .select()
  .from(schema.events)
  .where(eq(schema.events.userId, userId))
  .orderBy(desc(schema.events.occurredAt))
  .limit(40)
  .all();

const fmtMin = (s: number) => (s / 60).toFixed(1);
const flash = Astro.url.searchParams.get("done");
const flashError = Astro.url.searchParams.get("error");
// Clinic this user owns, if any — shown alongside the account-type switch so
// it's clear what a clinic account already has behind it.
const ownedClinic = await db
  .select({ id: schema.clinics.id, name: schema.clinics.name })
  .from(schema.clinics)
  .where(eq(schema.clinics.ownerUserId, userId))
  .get();
// Allowlisted emails are admins from their next login, even while the row
// still says "student" — keep the switch away from them too, not just from
// accounts already carrying the site_admin role.
const isSiteAdmin =
  student.role === "site_admin" ||
  isAdminEmail(Astro.locals.runtime.env, student.email);

// At-a-glance summary: flags + course state, from the same roster logic as
// the Students list, so the two never disagree.
const [summary] = await buildRoster(db, { userId, withMailing: false });
const attention = summary?.flags.filter((fl) => ATTENTION.includes(fl)) ?? [];

// Marketing-list status (same rules as Admin → Audience).
const mailing = await getMailingStatus(db, student.email).catch(() => null);
const lastPref = await lastPrefEvent(db, student.email).catch(() => null);
---

<Layout title={`${student.legalName || student.email} · Admin`} showNav={true}>
  <AdminNav active="students" />
  <p style="margin:0"><a href="/admin/students">← All students</a></p>
  <h1 style="margin-bottom:0.25rem">{student.legalName?.trim() || "— no legal name —"}</h1>
  <p class="muted" style="margin-top:0">
    {student.email} · role: {student.role} ·{" "}
    intake {student.intakeCompletedAt ? formatPacific(student.intakeCompletedAt, { dateStyle: "medium" }) : "not completed"}
  </p>

  {summary && (
    <div class="panel sum-card">
      {attention.length > 0 && (
        <ul class="sum-attn">
          {attention.map((fl) => (
            <li><strong>{FLAG_LABEL[fl]}</strong> <span>{FLAG_HELP[fl]}</span></li>
          ))}
        </ul>
      )}
      <div class="sum-grid">
        <div>
          <div class="sum-k">Last sign-in</div>
          <div class="sum-v" title={summary.lastLoginAt ? formatPacific(summary.lastLoginAt) : ""}>{ago(summary.lastLoginAt)}</div>
        </div>
        <div>
          <div class="sum-k">Last activity</div>
          <div class="sum-v" title={summary.lastActivityAt ? formatPacific(summary.lastActivityAt) : ""}>{ago(summary.lastActivityAt)}</div>
        </div>
        <div>
          <div class="sum-k">Joined</div>
          <div class="sum-v">{formatPacific(summary.createdAt, { dateStyle: "medium" })}</div>
        </div>
        <div>
          <div class="sum-k">Certificates</div>
          <div class="sum-v">{summary.certs}</div>
        </div>
      </div>
      {summary.courses.length > 0 && (
        <ul class="sum-courses">
          {summary.courses.map((c) => (
            <li>
              <strong>{c.title}</strong>
              <span class="muted">
                {" · "}
                {c.status === "completed"
                  ? "completed"
                  : c.status === "active"
                    ? c.finalPassed
                      ? "passed the final exam"
                      : c.examUnlocked
                        ? "final exam unlocked, not passed yet"
                        : c.progress == null
                          ? "no video yet"
                          : `${Math.round(c.progress * 100)}% watched`
                    : c.status === "pending"
                      ? "checkout not finished"
                      : "refunded"}
                {c.finalFails > 0 && !c.finalPassed && ` · ${c.finalFails} failed exam attempt${c.finalFails === 1 ? "" : "s"}`}
                {c.hasCert && " · certificate issued"}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}

  <form method="POST" action="/api/impersonate" style="margin:0 0 0.5rem">
    <input type="hidden" name="userId" value={userId} />
    <button class="btn-secondary" type="submit" style="margin:0">
      👁 View as this user (read-only)
    </button>
  </form>

  {flash && (
    <div class="panel" style="border-color:var(--ok);color:var(--ok)">{flash}</div>
  )}

  {flashError && (
    <div class="panel" style="border-color:var(--danger);color:var(--danger)">{flashError}</div>
  )}

  {!isSiteAdmin && (
    <details class="panel fold">
      <summary><h2>Account type</h2></summary>
      <p class="muted" style="margin-top:0;font-size:0.9rem">
        Currently <strong>{student.role === "clinic_admin" ? "clinic owner" : "student"}</strong>
        {ownedClinic && <span> · owns <strong>{ownedClinic.name}</strong></span>}.
        Switching to a clinic owner also creates their clinic and clinic roadmap
        so they can buy seats and invite CAs. Switching back to student leaves
        any clinic, its seats, and its members intact. Enrollments and
        certificates are never affected either way.
      </p>
      <form method="POST" action={`/api/admin/users/${userId}/account-type`} class="acct-type-form" style="display:flex;gap:0.5rem;align-items:flex-end;flex-wrap:wrap;margin:0">
        <div style="flex:0 0 12rem">
          <label style="margin:0">Account type</label>
          <select name="role" id="acct-role" style="width:100%">
            <option value="student" selected={student.role === "student"}>Student</option>
            <option value="clinic_admin" selected={student.role === "clinic_admin"}>Clinic owner</option>
          </select>
        </div>
        <div style="flex:1 1 16rem">
          <label style="margin:0">Clinic name</label>
          <input
            type="text"
            name="clinicName"
            id="acct-clinic-name"
            value={ownedClinic?.name ?? student.clinicName ?? ""}
            placeholder="required when switching to a clinic owner"
          />
        </div>
        <button type="submit" style="margin:0">Change account type</button>
      </form>
    </details>
  )}

  {!isSiteAdmin && (
    <details class="panel fold">
      <summary><h2>Sign-in email</h2></summary>
      <p class="muted" style="margin-top:0;font-size:0.9rem">
        Currently <strong>{student.email}</strong>. This address IS the login —
        sign-in links go to it and nothing else. Changing it moves their clinic
        membership to the new address, cancels any sign-in link already sent to
        either address, and emails a notice to both. Progress, quiz attempts,
        and issued certificates are untouched (certificates print the legal
        name, not the email, so they stay valid as printed). Recorded in the
        audit trail.
      </p>
      <form method="POST" action={`/api/admin/users/${userId}/email`} class="email-change-form" style="margin:0">
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:flex-end">
          <div style="flex:1 1 16rem">
            <label style="margin:0">New email</label>
            <input type="email" name="newEmail" id="new-email" autocomplete="off" required style="width:100%" />
          </div>
          <div style="flex:1 1 16rem">
            <label style="margin:0">Repeat new email</label>
            <input type="email" name="newEmailConfirm" id="new-email-confirm" autocomplete="off" required style="width:100%" />
          </div>
        </div>
        <div style="margin-top:0.5rem">
          <label style="margin:0">Reason (recorded)</label>
          <input type="text" name="reason" id="email-change-reason" required
            placeholder="e.g. student mistyped their address at signup"
            style="width:100%;max-width:32rem" />
        </div>
        <label style="display:flex;gap:0.4rem;align-items:center;margin:0.5rem 0 0.75rem;font-weight:normal">
          <input type="checkbox" name="keepSessions" style="width:auto;margin:0" />
          <span class="muted" style="font-size:0.85rem">
            Keep them signed in on their current devices (by default they're
            signed out everywhere and sign back in with the new address)
          </span>
        </label>
        <button type="submit" style="margin:0">Change sign-in email</button>
      </form>
    </details>
  )}

  {!student.legalName?.trim() && (
    <div class="panel" style="border-color:var(--warn)">
      <strong style="color:var(--warn)">No legal name on file.</strong>
      <span class="muted"> Certificates can't be issued until the student completes intake with their legal name.</span>
    </div>
  )}

  {mailing && (
    <div class="panel">
      <h2 style="margin-top:0">Mailing list</h2>
      <p style="margin-top:0">
        <strong style={mailing.status === "subscribed" ? "color:var(--ok)" : mailing.status === "unsubscribed" ? "color:var(--danger)" : ""}>
          {STATUS_LABEL[mailing.status]}
        </strong>
        <span class="muted"> · {STATUS_HELP[mailing.status]}</span>
      </p>
      <ul class="muted" style="font-size:0.9rem;line-height:1.7;margin:0 0 0.75rem;padding-left:1.1rem">
        <li>Known from: {mailing.sources.join(", ")}</li>
        {mailing.tags.length > 0 && <li>Tags: {mailing.tags.join(", ")}</li>}
        {mailing.consentAt && <li>Consented {formatPacific(mailing.consentAt, { dateStyle: "medium" })}</li>}
        {lastPref && (
          <li>
            {lastPref.type === "marketing_unsubscribed" ? "Unsubscribed" : "Resubscribed"}{" "}
            {formatPacific(lastPref.occurredAt, { dateStyle: "medium" })} via{" "}
            {(lastPref.payload as { source?: string } | null)?.source ?? "unknown"}
            {(lastPref.payload as { reason?: string } | null)?.reason && (
              <span>: “{(lastPref.payload as { reason?: string }).reason}”</span>
            )}
          </li>
        )}
      </ul>
      <form method="POST" action="/api/admin/audience/preference" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin:0">
        <input type="hidden" name="email" value={student.email} />
        <input type="hidden" name="back" value={`/admin/students/${userId}`} />
        <input type="hidden" name="action" value={mailing.status === "unsubscribed" ? "resubscribe" : "unsubscribe"} />
        <input type="text" name="reason" required style="flex:1 1 16rem;max-width:28rem;margin:0"
          placeholder={mailing.status === "unsubscribed" ? "Their request, e.g. “asked by phone”" : "Reason, e.g. “asked by email”"} />
        <button type="submit" class="btn-secondary" style="margin:0">
          {mailing.status === "unsubscribed" ? "Resubscribe" : "Unsubscribe from marketing"}
        </button>
      </form>
    </div>
  )}

  <!-- Per-course seat-time audit -->
  {
    courseAudits.length === 0 ? (
      <div class="panel"><p style="margin:0">No enrollments.</p></div>
    ) : (
      courseAudits.map(({ enrollment, course, seat, certs, unpassed, modules }) => (
        <div class="panel">
          <h2 style="margin-bottom:0.25rem">{course.title}</h2>
          <p class="muted" style="margin-top:0;font-size:0.9rem">
            Enrollment: {enrollment.status} · payment: {enrollment.paymentStatus}
            {enrollment.completedAt && ` · completed ${formatPacific(enrollment.completedAt, { dateStyle: "medium" })}`}
          </p>

          <p style="margin:0.5rem 0">
            Content watched:{" "}
            <strong style="color:var(--text)">{Math.round(seat.watchedFraction * 100)}%</strong>{" "}
            ({fmtMin(seat.creditedSeconds)} of {fmtMin(seat.totalContentSeconds)} min) ·{" "}
            exam gate:{" "}
            <strong style={seat.examUnlocked ? "color:var(--ok)" : "color:var(--warn)"}>
              {seat.examUnlocked ? "unlocked" : "locked"}
            </strong>
          </p>

          <details style="margin-top:0.5rem" open={!seat.examUnlocked && seat.creditedSeconds > 0}>
          <summary class="muted" style="cursor:pointer;font-size:0.9rem">Per-lesson seat time ({seat.perLesson.length} {seat.perLesson.length === 1 ? "lesson" : "lessons"})</summary>
          <table style="width:100%;border-collapse:collapse;font-size:0.88rem;margin-top:0.5rem">
            <thead>
              <tr style="text-align:left;color:var(--muted)">
                <th style="padding:0.3rem 0.4rem">Lesson</th>
                <th style="padding:0.3rem 0.4rem">Credited</th>
                <th style="padding:0.3rem 0.4rem">Length</th>
                <th style="padding:0.3rem 0.4rem">%</th>
                <th style="padding:0.3rem 0.4rem">≥90%</th>
                <th style="padding:0.3rem 0.4rem"></th>
              </tr>
            </thead>
            <tbody>
              {seat.perLesson.map((p) => (
                <tr style="border-top:1px solid var(--border)">
                  <td style="padding:0.3rem 0.4rem">{p.title}</td>
                  <td style="padding:0.3rem 0.4rem">{fmtMin(p.creditedSeconds)}m</td>
                  <td style="padding:0.3rem 0.4rem">{fmtMin(p.durationSeconds)}m</td>
                  <td style="padding:0.3rem 0.4rem">{Math.round(p.fraction * 100)}%</td>
                  <td style="padding:0.3rem 0.4rem">{p.meetsThreshold ? "✓" : "–"}</td>
                  <td style="padding:0.3rem 0.4rem;text-align:right">
                    <form method="POST" action={`/api/admin/users/${userId}/reset-lesson`} class="seat-reset-form" style="margin:0;display:inline">
                      <input type="hidden" name="lessonId" value={p.lessonId} />
                      <button type="submit" title="Reset seat time for this lesson"
                        style="font-size:0.78rem;padding:0.15rem 0.5rem;border:1px solid var(--border);border-radius:6px;background:var(--panel);color:var(--text);cursor:pointer">Reset</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </details>

          {/* Per-module seat-time reset (troubleshooting) */}
          <details style="margin-top:0.6rem">
            <summary class="muted" style="cursor:pointer;font-size:0.85rem">Reset a whole module's seat time</summary>
            <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:0.4rem">
              {modules.map(({ module }) => (
                <form method="POST" action={`/api/admin/users/${userId}/reset-module`} class="seat-reset-form" style="margin:0">
                  <input type="hidden" name="moduleId" value={module.id} />
                  <button type="submit"
                    style="font-size:0.8rem;padding:0.25rem 0.6rem;border:1px solid var(--border);border-radius:7px;background:var(--panel);color:var(--text);cursor:pointer">↺ {module.title}</button>
                </form>
              ))}
            </div>
          </details>

          {/* Certificates for this course */}
          <div style="margin-top:1rem">
            <h3 style="font-size:1rem;margin:0 0 0.5rem">Certificates</h3>
            {certs.length === 0 ? (
              <p class="muted" style="margin:0;font-size:0.9rem">None issued.</p>
            ) : (
              certs.map((cert) => (
                <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;padding:0.5rem 0;border-top:1px solid var(--border);font-size:0.9rem">
                  <code>{cert.certNumber}</code>
                  <span
                    style={`padding:0.1rem 0.5rem;border-radius:6px;font-size:0.8rem;${
                      cert.status === "issued"
                        ? "background:var(--success-tint);color:var(--success)"
                        : cert.status === "revoked"
                          ? "background:var(--danger-tint);color:var(--danger)"
                          : "background:var(--warning-tint);color:var(--warning-ink)"
                    }`}
                  >
                    {cert.status}
                  </span>
                  <span class="muted">{formatPacific(cert.issuedAt, { dateStyle: "medium" })}</span>
                  <a href={`/certificate/${cert.verificationCode}.pdf`}>PDF</a>
                  <a href={`/verify/${cert.verificationCode}`}>verify</a>
                  <span style="flex:1" />
                  {cert.status === "issued" && (
                    <>
                      <form method="POST" action={`/api/admin/certificates/${cert.id}/reissue`} style="margin:0">
                        <button class="link" type="submit">Reissue</button>
                      </form>
                      <form
                        method="POST"
                        action={`/api/admin/certificates/${cert.id}/revoke`}
                        style="margin:0"
                        onsubmit="return confirm('Revoke this certificate? It will show as invalid on the public verify page.')"
                      >
                        <button class="link" type="submit" style="color:var(--danger)">Revoke</button>
                      </form>
                    </>
                  )}
                </div>
              ))
            )}
            {!certs.some((c) => c.status === "issued") && (
              <form method="POST" action={`/api/admin/users/${userId}/certificate`} style="margin:0.75rem 0 0">
                <input type="hidden" name="courseId" value={course.id} />
                {unpassed.length > 0 && (
                  <p class="muted" style="margin:0 0 0.4rem;font-size:0.85rem;color:var(--warn)">
                    Quizzes not passed yet: {unpassed.map((q) => q.title).join(", ")}.
                  </p>
                )}
                <label for={`reason-${course.id}`} style="font-size:0.85rem;margin-top:0.4rem">
                  Reason (recorded in the audit trail)
                </label>
                <input
                  id={`reason-${course.id}`}
                  type="text"
                  name="reason"
                  required
                  maxlength="500"
                  placeholder="e.g. completed the live session on 2026-10-14; knowledge check not applicable"
                  style="width:100%;max-width:34rem"
                />
                <button type="submit" disabled={!student.legalName?.trim()} style="margin-top:0.6rem">
                  Issue certificate for this course
                </button>
                {unpassed.length > 0 && (
                  <label class="check" style="margin-left:0.75rem;font-size:0.85rem">
                    <input type="checkbox" name="override" />
                    <span>Issue anyway (override quiz requirement)</span>
                  </label>
                )}
                {!student.legalName?.trim() && (
                  <span class="muted" style="margin-left:0.5rem;font-size:0.85rem">
                    Needs a legal name (student must complete intake).
                  </span>
                )}
              </form>
            )}
          </div>
        </div>
      ))
    )
  }

  <!-- Quiz attempts -->
  <details class="panel fold">
    <summary><h2>Quiz attempts <span class="muted" style="font-size:0.9rem">({attempts.length}, append-only)</span></h2></summary>
    {
      attempts.length === 0 ? (
        <p style="margin:0">No attempts.</p>
      ) : (
        <table style="width:100%;border-collapse:collapse;font-size:0.88rem">
          <thead>
            <tr style="text-align:left;color:var(--muted)">
              <th style="padding:0.3rem 0.4rem">Quiz</th>
              <th style="padding:0.3rem 0.4rem">Kind</th>
              <th style="padding:0.3rem 0.4rem">#</th>
              <th style="padding:0.3rem 0.4rem">Score</th>
              <th style="padding:0.3rem 0.4rem">Result</th>
              <th style="padding:0.3rem 0.4rem">Submitted</th>
            </tr>
          </thead>
          <tbody>
            {attempts.map((a) => {
              const quiz = quizMap.get(a.quizId);
              return (
                <tr style="border-top:1px solid var(--border)">
                  <td style="padding:0.3rem 0.4rem">{quiz?.title ?? a.quizId}</td>
                  <td style="padding:0.3rem 0.4rem">{quiz?.kind ?? "—"}</td>
                  <td style="padding:0.3rem 0.4rem">{a.attemptNumber}</td>
                  <td style="padding:0.3rem 0.4rem">{Math.round(a.score * 100)}%</td>
                  <td style={`padding:0.3rem 0.4rem;${a.passed ? "color:var(--ok)" : "color:var(--danger)"}`}>
                    {a.passed ? "pass" : "fail"}
                  </td>
                  <td style="padding:0.3rem 0.4rem">{formatPacific(a.submittedAt, { dateStyle: "short", timeStyle: "short" })}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )
    }
  </details>

  <!-- Raw event trail -->
  <details class="panel fold">
    <summary><h2>Recent activity <span class="muted" style="font-size:0.9rem">({events.length})</span></h2></summary>
    {
      events.length === 0 ? (
        <p style="margin:0">No events.</p>
      ) : (
        <ul style="list-style:none;padding:0;margin:0;font-size:0.85rem">
          {events.map((ev) => (
            <li style="padding:0.3rem 0;border-top:1px solid var(--border);display:flex;gap:0.75rem">
              <span class="muted" style="white-space:nowrap">{formatPacific(ev.occurredAt, { dateStyle: "short", timeStyle: "short" })}</span>
              <code>{ev.type}</code>
            </li>
          ))}
        </ul>
      )
    }
  </details>

  <div class="panel" style="border-color:var(--warn);margin-top:1.5rem">
    <h2 style="margin-top:0;color:var(--warn)">Danger zone</h2>

    <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-start">
      <form method="POST" action={`/api/admin/users/${userId}/reset`} class="reset-form" style="flex:1 1 18rem;margin:0">
        <strong>Reset progress</strong>
        <p class="muted" style="margin:0.25rem 0 0.5rem;font-size:0.85rem">
          Keeps the account, intake, and roadmap. Clears enrollments, seat-time
          events, quiz attempts, certificates, and uploaded documents so they can
          start over. Cannot be undone.
        </p>
        <button type="submit">Reset this user's progress</button>
      </form>

      <form method="POST" action={`/api/admin/users/${userId}/delete`} class="delete-form" style="flex:1 1 18rem;margin:0">
        <strong style="color:var(--warn)">Delete user</strong>
        <p class="muted" style="margin:0.25rem 0 0.5rem;font-size:0.85rem">
          Permanently removes {student.email} and ALL their data (account,
          progress, certificates, documents, clinic, sessions). Cannot be undone.
          Type the email to confirm.
        </p>
        <input type="email" name="confirmEmail" placeholder={student.email} autocomplete="off"
          style="width:100%;max-width:24rem;margin-bottom:0.5rem" />
        <br />
        <button type="submit" style="background:var(--warn);border-color:var(--warn)">Delete this user</button>
      </form>
    </div>
  </div>

  <style>
    .sum-card { padding: 1rem 1.1rem; }
    .sum-attn { list-style: none; margin: 0 0 0.85rem; padding: 0.6rem 0.8rem; border-radius: 8px; background: var(--warning-tint); color: var(--warning-ink); font-size: 0.9rem; }
    .sum-attn li + li { margin-top: 0.3rem; }
    .sum-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: 0.75rem; }
    .sum-k { font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .sum-v { font-weight: 600; }
    .sum-courses { margin: 0.85rem 0 0; padding-left: 1.1rem; font-size: 0.92rem; line-height: 1.6; }
    details.fold > summary { cursor: pointer; list-style: none; }
    details.fold > summary::-webkit-details-marker { display: none; }
    details.fold > summary h2 { display: inline; margin: 0; font-size: 1.15rem; }
    details.fold > summary::before { content: "▸"; display: inline-block; width: 1.1rem; color: var(--muted); }
    details.fold[open] > summary::before { content: "▾"; }
    details.fold[open] > summary { margin-bottom: 0.75rem; }
  </style>

  <script is:inline>
    document.querySelector(".acct-type-form")?.addEventListener("submit", (e) => {
      const role = document.getElementById("acct-role")?.value;
      const name = document.getElementById("acct-clinic-name")?.value.trim();
      if (role === "clinic_admin" && !name) {
        alert("Enter a clinic name — a clinic account needs one to create the clinic.");
        e.preventDefault();
        return;
      }
      const msg =
        role === "clinic_admin"
          ? `Switch this account to a clinic owner and set up "${name}" as their clinic?`
          : "Switch this account back to a student? Any clinic they own stays intact.";
      if (!confirm(msg)) e.preventDefault();
    });
    document.querySelector(".email-change-form")?.addEventListener("submit", (e) => {
      const a = document.getElementById("new-email")?.value.trim().toLowerCase();
      const b = document.getElementById("new-email-confirm")?.value.trim().toLowerCase();
      if (!a || a !== b) {
        alert("The two email addresses don't match. Retype the new address to confirm it.");
        e.preventDefault();
        return;
      }
      if (!document.getElementById("email-change-reason")?.value.trim()) {
        alert("Add a reason \u2014 the change is recorded in the audit trail.");
        e.preventDefault();
        return;
      }
      if (!confirm("Change this student's sign-in email to " + a + "? They will sign in with that address from now on.")) e.preventDefault();
    });
    document.querySelector(".reset-form")?.addEventListener("submit", (e) => {
      if (!confirm("Reset this user's progress? Enrollments, seat time, attempts, and certificates will be permanently cleared.")) e.preventDefault();
    });
    document.querySelector(".delete-form")?.addEventListener("submit", (e) => {
      if (!confirm("Permanently DELETE this user and all their data? This cannot be undone.")) e.preventDefault();
    });
    document.querySelectorAll(".seat-reset-form").forEach((f) => {
      f.addEventListener("submit", (e) => {
        if (!confirm("Reset seat time here? The student's watched-time for this lesson/module is cleared so they can re-watch. Quiz attempts and certificates are kept.")) e.preventDefault();
      });
    });
  </script>
</Layout>
