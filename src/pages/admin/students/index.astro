---
import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/AdminNav.astro";
import { getDb, schema } from "@/db/client";
import { desc } from "drizzle-orm";

const db = getDb(Astro.locals.runtime.env);

const users = await db
  .select()
  .from(schema.users)
  .orderBy(desc(schema.users.createdAt))
  .all();
const enrollments = await db.select().from(schema.enrollments).all();
const certs = await db.select().from(schema.certificates).all();

const enrollByUser = new Map<string, typeof enrollments>();
for (const e of enrollments) {
  const list = enrollByUser.get(e.userId) ?? [];
  list.push(e);
  enrollByUser.set(e.userId, list);
}
const certCountByUser = new Map<string, number>();
for (const c of certs) {
  if (c.status === "issued")
    certCountByUser.set(c.userId, (certCountByUser.get(c.userId) ?? 0) + 1);
}

const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const rows = users
  .filter(
    (u) =>
      !q ||
      u.email.toLowerCase().includes(q) ||
      (u.legalName ?? "").toLowerCase().includes(q),
  )
  .map((u) => {
    const es = enrollByUser.get(u.id) ?? [];
    return {
      user: u,
      enrolled: es.filter((e) => e.status === "active" || e.status === "completed").length,
      completed: es.filter((e) => e.status === "completed").length,
      certs: certCountByUser.get(u.id) ?? 0,
    };
  });
---

<Layout title="Students · Admin" showNav={true}>
  <AdminNav active="students" />
  <h1>Students <span class="muted" style="font-size:1rem">({rows.length})</span></h1>

  <form method="get" class="stu-search">
    <input
      type="text"
      name="q"
      value={q}
      placeholder="Search name or email…"
    />
    <button type="submit" style="margin-top:0">Search</button>
    {q && <a href="/admin/students" class="stu-clear">Clear</a>}
  </form>

  <div class="panel" style="padding:0">
    <div class="table-scroll">
      <table class="stu-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th class="num" title="Intake completed">Intake</th>
            <th class="num" title="Active/completed course enrolments">Courses</th>
            <th class="num" title="Courses completed">Done</th>
            <th class="num" title="Certificates issued">Certs</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <td class="cell-name">
                  <a href={`/admin/students/${r.user.id}`}>
                    {r.user.legalName?.trim() || <span class="muted">— no name —</span>}
                  </a>
                </td>
                <td class="cell-email">{r.user.email}</td>
                <td><span class="role-badge">{r.user.role}</span></td>
                <td class="num">{r.user.intakeCompletedAt ? "✓" : <span class="muted">–</span>}</td>
                <td class="num">{r.enrolled}</td>
                <td class="num">{r.completed}</td>
                <td class="num">{r.certs}</td>
              </tr>
            ))
          }
          {rows.length === 0 && (
            <tr>
              <td colspan="7" style="padding:0.9rem 0.75rem" class="muted">No students match.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <style>
    .stu-search { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin: 0 0 1rem; }
    .stu-search input { flex: 1; min-width: 12rem; max-width: 22rem; }
    .stu-clear { font-size: 0.9rem; white-space: nowrap; }

    /* Keep wide content scrolling INSIDE the panel — never overflow the page. */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .stu-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; min-width: 640px; }
    .stu-table th,
    .stu-table td { padding: 0.55rem 0.75rem; vertical-align: middle; }
    .stu-table thead th {
      text-align: left; color: var(--muted); font-weight: 600; white-space: nowrap;
      border-bottom: 1px solid var(--border);
    }
    .stu-table tbody tr { border-top: 1px solid var(--border); }
    .stu-table tbody tr:first-child { border-top: 0; }
    /* Numeric columns: centered, compact, never clipped. */
    .stu-table .num { text-align: center; white-space: nowrap; width: 1%; font-variant-numeric: tabular-nums; }
    .stu-table thead .num { text-align: center; }
    .cell-name a { font-weight: 600; }
    .cell-email { color: var(--muted); word-break: break-all; }
    .role-badge {
      font-size: 0.78rem; color: var(--muted); background: var(--brand-tint);
      border-radius: 6px; padding: 0.1rem 0.45rem; white-space: nowrap;
    }
  </style>
</Layout>
