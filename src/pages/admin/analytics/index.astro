---
/**
 * Admin analytics — privacy-first. Top-of-funnel traffic comes from Cloudflare
 * Web Analytics (cookieless); this page shows first-party CONVERSION attribution
 * (leads/purchases tied to ad campaigns via the `attribution` events) plus the
 * overall funnel counts. Admin-guarded by middleware.
 */
import Layout from "@/layouts/Layout.astro";
import AdminNav from "@/components/AdminNav.astro";
import { getDb, schema } from "@/db/client";
import { eq, desc, sql } from "drizzle-orm";

const env = Astro.locals.runtime.env;
const db = getDb(env);

const attrEvents = await db
  .select()
  .from(schema.events)
  .where(eq(schema.events.type, "attribution"))
  .orderBy(desc(schema.events.occurredAt))
  .limit(2000)
  .all();

interface Row {
  source: string;
  campaign: string;
  medium: string;
  lead: number;
  purchase: number;
  total: number;
}
const byCampaign = new Map<string, Row>();
for (const e of attrEvents) {
  const p = (e.payload as Record<string, string> | null) ?? {};
  const source = p.source || "(none)";
  const campaign = p.campaign || "(none)";
  const medium = p.medium || "";
  const key = `${source}|${campaign}|${medium}`;
  const row =
    byCampaign.get(key) ?? { source, campaign, medium, lead: 0, purchase: 0, total: 0 };
  if (p.context === "lead") row.lead++;
  else if (p.context === "purchase") row.purchase++;
  row.total++;
  byCampaign.set(key, row);
}
const rows = [...byCampaign.values()].sort((a, b) => b.total - a.total);

async function countType(t: string): Promise<number> {
  const r = await db
    .select({ c: sql<number>`count(*)` })
    .from(schema.events)
    .where(eq(schema.events.type, t))
    .get();
  return Number(r?.c ?? 0);
}
const totals = {
  leads: await countType("lead_captured"),
  confirmed: await countType("lead_confirmed"),
  signups: await countType("signup"),
  enrollments: await countType("enrollment_activated"),
};
const analyticsOn = !!env.CF_WEB_ANALYTICS_TOKEN;

// ---- First-party traffic (page_metrics, last 30 days) ----------------------
const since = new Date(Date.now() - 30 * 24 * 3600 * 1000).toISOString();
const pm = schema.pageMetrics;

const trafficTotal = Number(
  (
    await db
      .select({ c: sql<number>`count(*)` })
      .from(pm)
      .where(sql`${pm.occurredAt} >= ${since}`)
      .get()
  )?.c ?? 0,
);

const byChannel = await db
  .select({ channel: pm.channel, views: sql<number>`count(*)` })
  .from(pm)
  .where(sql`${pm.occurredAt} >= ${since}`)
  .groupBy(pm.channel)
  .orderBy(sql`count(*) desc`)
  .all();

// The SEO scoreboard: which pages win ORGANIC SEARCH entries.
const organicLandings = await db
  .select({ path: pm.path, views: sql<number>`count(*)` })
  .from(pm)
  .where(sql`${pm.occurredAt} >= ${since} AND ${pm.channel} = 'organic'`)
  .groupBy(pm.path)
  .orderBy(sql`count(*) desc`)
  .limit(15)
  .all();

const organicEngines = await db
  .select({ host: pm.referrerHost, views: sql<number>`count(*)` })
  .from(pm)
  .where(sql`${pm.occurredAt} >= ${since} AND ${pm.channel} = 'organic'`)
  .groupBy(pm.referrerHost)
  .orderBy(sql`count(*) desc`)
  .limit(10)
  .all();

const topPages = await db
  .select({ path: pm.path, views: sql<number>`count(*)` })
  .from(pm)
  .where(sql`${pm.occurredAt} >= ${since} AND ${pm.channel} != 'internal'`)
  .groupBy(pm.path)
  .orderBy(sql`count(*) desc`)
  .limit(15)
  .all();

const topReferrers = await db
  .select({ host: pm.referrerHost, views: sql<number>`count(*)` })
  .from(pm)
  .where(
    sql`${pm.occurredAt} >= ${since} AND ${pm.channel} = 'referral' AND ${pm.referrerHost} IS NOT NULL`,
  )
  .groupBy(pm.referrerHost)
  .orderBy(sql`count(*) desc`)
  .limit(10)
  .all();

const byDay = await db
  .select({
    day: sql<string>`substr(${pm.occurredAt}, 1, 10)`,
    views: sql<number>`count(*)`,
    organic: sql<number>`sum(case when ${pm.channel} = 'organic' then 1 else 0 end)`,
  })
  .from(pm)
  .where(sql`${pm.occurredAt} >= ${since}`)
  .groupBy(sql`substr(${pm.occurredAt}, 1, 10)`)
  .orderBy(sql`substr(${pm.occurredAt}, 1, 10) desc`)
  .limit(30)
  .all();
---

<Layout title="Analytics · Admin" showNav={true}>
  <AdminNav active="analytics" />
  <h1>Analytics</h1>
  <p class="muted" style="margin-top:0;max-width:50rem">
    Traffic lives in <strong>Cloudflare Web Analytics</strong> (cookieless). This
    page shows <strong>conversions tied to ad campaigns</strong> — tag your ad URLs
    with <code>?utm_source=…&amp;utm_campaign=…</code> and the leads/purchases they
    drive show up below.
  </p>

  {!analyticsOn && (
    <p class="panel" style="background:var(--warning-tint,#fdf6ec);color:var(--warning-ink,#633806);border:none">
      ⚠️ Cloudflare Web Analytics isn't enabled yet — set <code>CF_WEB_ANALYTICS_TOKEN</code>
      so raw traffic (visits, top pages, referrers) is captured. Conversion
      attribution below works regardless.
    </p>
  )}

  <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0 1.5rem">
    {[
      { label: "Leads captured", v: totals.leads },
      { label: "Leads confirmed", v: totals.confirmed },
      { label: "Signups", v: totals.signups },
      { label: "Enrollments", v: totals.enrollments },
    ].map((s) => (
      <div class="panel" style="flex:1;min-width:9rem;text-align:center">
        <div style="font-size:1.9rem;font-weight:700;color:var(--text)">{s.v}</div>
        <div class="muted" style="font-size:0.85rem">{s.label}</div>
      </div>
    ))}
  </div>

  <h2 style="margin-bottom:0.25rem">Search &amp; traffic — last 30 days</h2>
  <p class="muted" style="margin-top:0;max-width:50rem">
    First-party pageviews (no cookies, no IDs) across the public site.
    <strong>Organic</strong> = arrived from a search or answer engine — the
    number to grow to win "chiropractic assistant oregon".
  </p>

  {trafficTotal === 0 ? (
    <p class="panel muted">
      No traffic recorded yet — the beacon starts counting on the next deploy.
      Check back in a day.
    </p>
  ) : (
    <>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0 1.5rem">
        <div class="panel" style="flex:1;min-width:9rem;text-align:center;margin:0">
          <div style="font-size:1.9rem;font-weight:700;color:var(--text)">{trafficTotal}</div>
          <div class="muted" style="font-size:0.85rem">Pageviews (30d)</div>
        </div>
        {byChannel.map((c) => (
          <div class="panel" style="flex:1;min-width:9rem;text-align:center;margin:0">
            <div style={`font-size:1.9rem;font-weight:700;color:${c.channel === "organic" ? "var(--ok)" : "var(--text)"}`}>{c.views}</div>
            <div class="muted" style="font-size:0.85rem;text-transform:capitalize">{c.channel}</div>
          </div>
        ))}
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.25rem;margin-bottom:1.5rem">
        <div class="panel" style="margin:0">
          <h3 style="margin:0 0 0.5rem;font-size:1rem">🔍 Organic search landings</h3>
          {organicLandings.length === 0 ? (
            <p class="muted" style="margin:0">None yet — this fills in as Google sends visitors.</p>
          ) : (
            <table style="width:100%;border-collapse:collapse;font-size:0.88rem">
              {organicLandings.map((r) => (
                <tr style="border-bottom:1px solid var(--border)">
                  <td style="padding:0.35rem 0.25rem;color:var(--text);word-break:break-all">{r.path}</td>
                  <td style="padding:0.35rem 0.25rem;text-align:right;font-weight:600">{r.views}</td>
                </tr>
              ))}
            </table>
          )}
          {organicEngines.length > 0 && (
            <p class="muted" style="margin:0.6rem 0 0;font-size:0.82rem">
              Engines: {organicEngines.map((e) => `${e.host} (${e.views})`).join(" · ")}
            </p>
          )}
        </div>

        <div class="panel" style="margin:0">
          <h3 style="margin:0 0 0.5rem;font-size:1rem">Top pages (external entries)</h3>
          <table style="width:100%;border-collapse:collapse;font-size:0.88rem">
            {topPages.map((r) => (
              <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:0.35rem 0.25rem;color:var(--text);word-break:break-all">{r.path}</td>
                <td style="padding:0.35rem 0.25rem;text-align:right;font-weight:600">{r.views}</td>
              </tr>
            ))}
          </table>
          {topReferrers.length > 0 && (
            <p class="muted" style="margin:0.6rem 0 0;font-size:0.82rem">
              Referrers: {topReferrers.map((e) => `${e.host} (${e.views})`).join(" · ")}
            </p>
          )}
        </div>
      </div>

      <details style="margin-bottom:1.5rem">
        <summary class="muted" style="cursor:pointer">Daily views (30d)</summary>
        <table style="width:100%;max-width:26rem;border-collapse:collapse;font-size:0.88rem;margin-top:0.5rem">
          <thead>
            <tr style="text-align:left;border-bottom:2px solid var(--border)">
              <th style="padding:0.35rem 0.25rem">Day</th>
              <th style="padding:0.35rem 0.25rem;text-align:right">Views</th>
              <th style="padding:0.35rem 0.25rem;text-align:right">Organic</th>
            </tr>
          </thead>
          <tbody>
            {byDay.map((d) => (
              <tr style="border-bottom:1px solid var(--border)">
                <td style="padding:0.35rem 0.25rem;color:var(--text)">{d.day}</td>
                <td style="padding:0.35rem 0.25rem;text-align:right">{d.views}</td>
                <td style="padding:0.35rem 0.25rem;text-align:right;color:var(--ok)">{d.organic}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </>
  )}

  <h2 style="margin-bottom:0.5rem">Conversions by campaign</h2>
  {rows.length === 0 ? (
    <p class="muted">
      No campaign conversions yet. They'll appear once visitors arrive via a
      UTM-tagged link (e.g. your postcard QR) and capture a lead or start checkout.
    </p>
  ) : (
    <table style="width:100%;border-collapse:collapse;font-size:0.92rem">
      <thead>
        <tr style="text-align:left;border-bottom:2px solid var(--border)">
          <th style="padding:0.5rem">Source</th>
          <th style="padding:0.5rem">Campaign</th>
          <th style="padding:0.5rem">Medium</th>
          <th style="padding:0.5rem;text-align:right">Leads</th>
          <th style="padding:0.5rem;text-align:right">Purchases</th>
          <th style="padding:0.5rem;text-align:right">Total</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr style="border-bottom:1px solid var(--border)">
            <td style="padding:0.5rem;color:var(--text)">{r.source}</td>
            <td style="padding:0.5rem">{r.campaign}</td>
            <td style="padding:0.5rem;color:var(--muted)">{r.medium || "—"}</td>
            <td style="padding:0.5rem;text-align:right">{r.lead}</td>
            <td style="padding:0.5rem;text-align:right">{r.purchase}</td>
            <td style="padding:0.5rem;text-align:right;font-weight:600">{r.total}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <p class="muted" style="margin-top:1.5rem;font-size:0.88rem">
    Raw traffic, top pages, and referrers (filter by your UTM tags): Cloudflare
    dashboard → your Pages project → <strong>Analytics &amp; Logs → Web Analytics</strong>.
  </p>
</Layout>
