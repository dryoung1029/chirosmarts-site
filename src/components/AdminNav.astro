---
/** Admin section sub-navigation. Full row on desktop; a hamburger that expands
 *  the section list on mobile so the links never run off-screen. */
interface Props {
  active?:
    | "overview"
    | "students"
    | "support"
    | "content"
    | "collateral"
    | "blog"
    | "aeo"
    | "analytics"
    | "revenue"
    | "contacts"
    | "legacy-certs";
}
const { active } = Astro.props;
const links: { key: string; href: string; label: string }[] = [
  { key: "overview", href: "/admin", label: "Overview" },
  { key: "students", href: "/admin/students", label: "Students" },
  { key: "support", href: "/admin/support", label: "Support" },
  { key: "content", href: "/admin/content", label: "Content" },
  { key: "collateral", href: "/admin/collateral", label: "Collateral" },
  { key: "blog", href: "/admin/blog", label: "Blog" },
  { key: "aeo", href: "/admin/aeo", label: "AEO" },
  { key: "analytics", href: "/admin/analytics", label: "Analytics" },
  { key: "revenue", href: "/admin/revenue", label: "Revenue" },
  { key: "contacts", href: "/admin/contacts", label: "Contacts" },
  { key: "legacy-certs", href: "/admin/legacy-certs", label: "Legacy certs" },
];
const activeLabel = links.find((l) => l.key === active)?.label ?? "Admin menu";
---

<nav class="admin-nav" aria-label="Admin sections">
  <button type="button" class="admin-nav-toggle" aria-expanded="false" aria-controls="admin-nav-links">
    <span>{activeLabel}</span>
    <span class="admin-nav-burger" aria-hidden="true">☰</span>
  </button>
  <div class="admin-nav-links" id="admin-nav-links">
    {
      links.map((l) => (
        <a href={l.href} class={active === l.key ? "is-active" : ""}>
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .admin-nav { margin: 0 0 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
  .admin-nav-links { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .admin-nav-links a {
    padding: 0.4rem 0.8rem; border-radius: 8px; text-decoration: none;
    font-size: 0.95rem; color: var(--muted); white-space: nowrap;
  }
  .admin-nav-links a.is-active { background: var(--accent); color: var(--accent-text); }
  /* Desktop: no hamburger, links always shown. */
  .admin-nav-toggle { display: none; }

  @media (max-width: 720px) {
    .admin-nav-toggle {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      width: 100%; cursor: pointer; padding: 0.55rem 0.85rem; border-radius: 8px;
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text); font-weight: 600; font-size: 0.95rem;
    }
    .admin-nav-burger { font-size: 1.1rem; }
    /* Collapsed by default on mobile; the toggle reveals the list. */
    .admin-nav-links { display: none; flex-direction: column; margin-top: 0.5rem; }
    .admin-nav.open .admin-nav-links { display: flex; }
    .admin-nav-links a { padding: 0.6rem 0.85rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".admin-nav-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const nav = btn.closest(".admin-nav");
      if (!nav) return;
      const open = nav.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });
  });
</script>
